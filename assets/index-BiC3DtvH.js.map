00\" y2=\"372\" stroke=\"#64748b\" stroke-width=\"1.5\" marker-end=\"url(#arrow)\"/>\n  <line x1=\"200\" y1=\"398\" x2=\"200\" y2=\"407\" stroke=\"#64748b\" stroke-width=\"1.5\" marker-end=\"url(#arrow)\"/>\n\n  <!-- 资产入库 节点 -->\n  <rect x=\"110\" y=\"207\" width=\"180\" height=\"26\" rx=\"4\" ry=\"4\" fill=\"#dbeafe\" stroke=\"#3b82f6\" stroke-width=\"1.5\"/>\n  <text x=\"200\" y=\"220\" text-anchor=\"middle\" dominant-baseline=\"central\" font-size=\"13\">创建资产入库单</text>\n  <rect x=\"110\" y=\"242\" width=\"180\" height=\"26\" rx=\"4\" ry=\"4\" fill=\"#dbeafe\" stroke=\"#3b82f6\" stroke-width=\"1.5\"/>\n  <text x=\"200\" y=\"255\" text-anchor=\"middle\" dominant-baseline=\"central\" font-size=\"13\">选择资产</text>\n  <polygon points=\"125,277 275,277 265,303 115,303\" fill=\"#ede9fe\" stroke=\"#8b5cf6\" stroke-width=\"1.5\"/>\n  <text x=\"195\" y=\"290\" text-anchor=\"middle\" dominant-baseline=\"central\" font-size=\"13\">填写数量</text>\n  <rect x=\"110\" y=\"312\" width=\"180\" height=\"26\" rx=\"4\" ry=\"4\" fill=\"#dbeafe\" stroke=\"#3b82f6\" stroke-width=\"1.5\"/>\n  <text x=\"200\" y=\"325\" text-anchor=\"middle\" dominant-baseline=\"central\" font-size=\"13\">保存</text>\n  <rect x=\"110\" y=\"347\" width=\"180\" height=\"26\" rx=\"4\" ry=\"4\" fill=\"#dbeafe\" stroke=\"#3b82f6\" stroke-width=\"1.5\"/>\n  <text x=\"200\" y=\"360\" text-anchor=\"middle\" dominant-baseline=\"central\" font-size=\"13\">提交</text>\n  <rect x=\"110\" y=\"382\" width=\"180\" height=\"26\" rx=\"4\" ry=\"4\" fill=\"#dbeafe\" stroke=\"#3b82f6\" stroke-width=\"1.5\"/>\n  <text x=\"200\" y=\"395\" text-anchor=\"middle\" dominant-baseline=\"central\" font-size=\"13\">确认入库</text>\n  <rect x=\"110\" y=\"417\" width=\"180\" height=\"26\" rx=\"4\" ry=\"4\" fill=\"#d1fae5\" stroke=\"#10b981\" stroke-width=\"1.5\"/>\n  <text x=\"200\" y=\"430\" text-anchor=\"middle\" dominant-baseline=\"central\" font-size=\"13\" fill=\"#065f46\" font-weight=\"bold\">资产库存增加</text>\n\n  <!-- 资产领用 连接线 -->\n  <line x1=\"