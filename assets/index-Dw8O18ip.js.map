rx=\"6\" fill=\"#dbeafe\" stroke=\"#3b82f6\" stroke-width=\"2\"/>\r\n  <text x=\"1000\" y=\"483\" text-anchor=\"middle\" font-size=\"14\" fill=\"#1e293b\">提交</text>\r\n\r\n  <rect x=\"920\" y=\"515\" width=\"160\" height=\"45\" rx=\"6\" fill=\"#dbeafe\" stroke=\"#3b82f6\" stroke-width=\"2\"/>\r\n  <text x=\"1000\" y=\"543\" text-anchor=\"middle\" font-size=\"14\" fill=\"#1e293b\">确认出库</text>\r\n\r\n  <!-- 库存扣减（汇聚） -->\r\n  <rect x=\"500\" y=\"600\" width=\"200\" height=\"50\" rx=\"6\" fill=\"#dbeafe\" stroke=\"#3b82f6\" stroke-width=\"2\"/>\r\n  <text x=\"600\" y=\"630\" text-anchor=\"middle\" font-size=\"15\" fill=\"#1e293b\" font-weight=\"bold\">库存扣减</text>\r\n\r\n  <circle cx=\"600\" cy=\"690\" r=\"25\" fill=\"#10b981\" stroke=\"#059669\" stroke-width=\"2\"/>\r\n  <text x=\"600\" y=\"695\" text-anchor=\"middle\" font-size=\"14\" fill=\"white\">完成</text>\r\n\r\n  <!-- 汇聚连接线 -->\r\n  <path d=\"M 200 560 L 200 585 L 540 585 L 540 598\" fill=\"none\" stroke=\"#64748b\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\r\n  <line x1=\"600\" y1=\"560\" x2=\"600\" y2=\"598\" stroke=\"#64748b\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\r\n  <path d=\"M 1000 560 L 1000 585 L 660 585 L 660 598\" fill=\"none\" stroke=\"#64748b\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\r\n\r\n  <line x1=\"600\" y1=\"650\" x2=\"600\" y2=\"665\" stroke=\"#64748b\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\r\n\r\n  <!-- 打印说明 -->\r\n  <rect x=\"400\" y=\"735\" width=\"400\" height=\"45\" rx=\"6\" fill=\"#fef3c7\" stroke=\"#f59e0b\" stroke-width=\"2\"/>\r\n  <text x=\"600\" y=\"763\" text-anchor=\"middle\" font-size=\"14\" fill=\"#1e293b\">所有单据生成后即可打印</text>\r\n\r\n  <!-- 列1连接线 -->\r\n  <line x1=\"200\" y1=\"140\" x2=\"200\" y2=\"153\" stroke=\"#64748b\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\r\n  <line x1=\"200\" y1=\"200\" x2=\"200\" y2=\"213\" stroke=\"#64748b\" stroke-width=\"2\" marker-end=\"url(#arrow)\"/>\r\n  <line x1=\"200\" y1=\"260\" x2=\"200\" y2=\"273\" str