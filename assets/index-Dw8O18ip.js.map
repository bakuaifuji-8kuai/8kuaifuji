export default "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\r\n<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 800\" font-family=\"Microsoft YaHei, sans-serif\">\r\n  <defs>\r\n    <marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto\">\r\n      <path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"#64748b\"/>\r\n    </marker>\r\n  </defs>\r\n  <rect width=\"1200\" height=\"800\" fill=\"#f8fafc\"/>\r\n  <text x=\"600\" y=\"42\" text-anchor=\"middle\" font-size=\"24\" font-weight=\"bold\" fill=\"#1e293b\">出库管理流程图</text>\r\n\r\n  <text x=\"200\" y=\"78\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"bold\" fill=\"#3b82f6\">低值易耗领用出库（LY）</text>\r\n  <text x=\"600\" y=\"78\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"bold\" fill=\"#3b82f6\">报废出库（BF）</text>\r\n  <text x=\"1000\" y=\"78\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"bold\" fill=\"#3b82f6\">报损出库（BS）</text>\r\n\r\n  <!-- 列1：领用出库 -->\r\n  <circle cx=\"200\" cy=\"115\" r=\"25\" fill=\"#10b981\" stroke=\"#059669\" stroke-width=\"2\"/>\r\n  <text x=\"200\" y=\"120\" text-anchor=\"middle\" font-size=\"14\" fill=\"white\">开始</text>\r\n\r\n  <rect x=\"120\" y=\"155\" width=\"160\" height=\"45\" rx=\"6\" fill=\"#dbeafe\" stroke=\"#3b82f6\" stroke-width=\"2\"/>\r\n  <text x=\"200\" y=\"183\" text-anchor=\"middle\" font-size=\"14\" fill=\"#1e293b\">创建领用单</text>\r\n\r\n  <rect x=\"120\" y=\"215\" width=\"160\" height=\"45\" rx=\"6\" fill=\"#dbeafe\" stroke=\"#3b82f6\" stroke-width=\"2\"/>\r\n  <text x=\"200\" y=\"243\" text-anchor=\"middle\" font-size=\"14\" fill=\"#1e293b\">选择物资</text>\r\n\r\n  <polygon points=\"135,275 295,275 280,320 120,320\" fill=\"#ede9fe\" stroke=\"#8b5cf6\" stroke-width=\"2\"/>\r\n  <text x=\"207\" y=\"303\" text-anchor=\"middle\" font-size=\"13\" fill=\"#1e293b\">填写领用数量</text>\r\n\r\n  <polygon points=\"135,335 295,335 280,380 120,380\" fill=\"#ede9fe\" stroke=\"#8b5cf6\" stroke-width=\"2\"/>\r\n  <text x