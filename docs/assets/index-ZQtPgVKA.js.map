aseline=\"central\">出库报表</text>\r\n\r\n    <rect x=\"860\" y=\"65\" width=\"120\" height=\"30\" rx=\"15\" fill=\"#e0f2fe\" stroke=\"#0ea5e9\" stroke-width=\"1.5\"/>\r\n    <text x=\"972\" y=\"80\" font-size=\"11\" fill=\"#0c4a6e\" text-anchor=\"end\" dominant-baseline=\"central\">财务报表</text>\r\n  </g>\r\n\r\n  <!-- 业务流程 subs (bottom, mixed alignment) -->\r\n  <g>\r\n    <rect x=\"420\" y=\"805\" width=\"120\" height=\"30\" rx=\"15\" fill=\"#ecfccb\" stroke=\"#84cc16\" stroke-width=\"1.5\"/>\r\n    <text x=\"428\" y=\"820\" font-size=\"11\" fill=\"#365314\" text-anchor=\"start\" dominant-baseline=\"central\">入库流程</text>\r\n\r\n    <rect x=\"540\" y=\"835\" width=\"120\" height=\"30\" rx=\"15\" fill=\"#ecfccb\" stroke=\"#84cc16\" stroke-width=\"1.5\"/>\r\n    <text x=\"548\" y=\"850\" font-size=\"11\" fill=\"#365314\" text-anchor=\"start\" dominant-baseline=\"central\">出库流程</text>\r\n\r\n    <rect x=\"740\" y=\"835\" width=\"120\" height=\"30\" rx=\"15\" fill=\"#ecfccb\" stroke=\"#84cc16\" stroke-width=\"1.5\"/>\r\n    <text x=\"852\" y=\"850\" font-size=\"11\" fill=\"#365314\" text-anchor=\"end\" dominant-baseline=\"central\">调拨流程</text>\r\n\r\n    <rect x=\"860\" y=\"805\" width=\"120\" height=\"30\" rx=\"15\" fill=\"#ecfccb\" stroke=\"#84cc16\" stroke-width=\"1.5\"/>\r\n    <text x=\"972\" y=\"820\" font-size=\"11\" fill=\"#365314\" text-anchor=\"end\" dominant-baseline=\"central\">盘点流程</text>\r\n  </g>\r\n\r\n  <!-- Legend -->\r\n  <g transform=\"translate(40,870)\">\r\n    <text x=\"0\" y=\"0\" font-size=\"10\" fill=\"#64748b\">说明：中心节点为系统主体，八个一级分支按方位均匀分布，曲线连接体现层级关系。</text>\r\n  </g>\r\n</svg>\r\n"