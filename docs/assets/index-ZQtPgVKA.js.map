export default "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1400 900\" font-family=\"Microsoft YaHei, sans-serif\">\r\n  <rect width=\"1400\" height=\"900\" fill=\"white\"/>\r\n\r\n  <!-- Title -->\r\n  <text x=\"700\" y=\"32\" font-size=\"22\" font-weight=\"bold\" text-anchor=\"middle\" fill=\"#1e293b\">仓库管理系统 — ER 实体关系图</text>\r\n  <text x=\"700\" y=\"52\" font-size=\"12\" text-anchor=\"middle\" fill=\"#64748b\">Entity-Relationship Diagram</text>\r\n\r\n  <!-- Relationship lines (behind boxes) -->\r\n  <g fill=\"none\" stroke-width=\"1.5\">\r\n    <!-- Warehouse -> Position : 1:N blue -->\r\n    <line x1=\"210\" y1=\"110\" x2=\"235\" y2=\"110\" stroke=\"#3b82f6\"/>\r\n    <text x=\"222\" y=\"103\" font-size=\"10\" fill=\"#3b82f6\" text-anchor=\"middle\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Warehouse -> Inventory : 1:N blue -->\r\n    <line x1=\"125\" y1=\"160\" x2=\"525\" y2=\"290\" stroke=\"#3b82f6\" stroke-dasharray=\"4 2\"/>\r\n    <text x=\"300\" y=\"220\" font-size=\"10\" fill=\"#3b82f6\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Position -> Inventory : 1:N blue -->\r\n    <line x1=\"320\" y1=\"160\" x2=\"475\" y2=\"290\" stroke=\"#3b82f6\" stroke-dasharray=\"4 2\"/>\r\n    <text x=\"385\" y=\"225\" font-size=\"10\" fill=\"#3b82f6\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- ProductCategory -> Product : 1:N purple -->\r\n    <line x1=\"710\" y1=\"102\" x2=\"735\" y2=\"110\" stroke=\"#8b5cf6\"/>\r\n    <text x=\"722\" y=\"95\" font-size=\"10\" fill=\"#8b5cf6\" text-anchor=\"middle\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Product -> Inventory : 1:N green -->\r\n    <line x1=\"820\" y1=\"160\" x2=\"560\" y2=\"290\" stroke=\"#10b981\" stroke-dasharray=\"4 2\"/>\r\n    <text x=\"700\" y=\"225\" font-size=\"10\" fill=\"#10b981\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Inventory -> BatchInventory : 1:N green -->\r\n    <line x1=\"610\" y1=\"340\" x2=\"640\" y2=\"340\" stroke=\"#10b981\"/>\r\n    <text x=\"625\" y=\"333\" font-size=\"10\" fill=\"#10b981\" text-anchor=\"middle\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Inventory -> StockTransaction : 1:N grey (routed below) -->\r\n    <path d=\"M 525 390 Q 525 420 625 420 T 925 390\" stroke=\"#64748b\" stroke-dasharray=\"4 2\"/>\r\n    <text x=\"725\" y=\"438\" font-size=\"10\" fill=\"#64748b\" text-anchor=\"middle\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- InboundOrder -> InboundDetail : 1:N orange -->\r\n    <line x1=\"210\" y1=\"560\" x2=\"235\" y2=\"560\" stroke=\"#f59e0b\"/>\r\n    <text x=\"222\" y=\"553\" font-size=\"10\" fill=\"#f59e0b\" text-anchor=\"middle\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- InboundOrder -> BatchInventory : 1:N orange -->\r\n    <line x1=\"125\" y1=\"510\" x2=\"725\" y2=\"390\" stroke=\"#f59e0b\" stroke-dasharray=\"4 2\"/>\r\n    <text x=\"430\" y=\"445\" font-size=\"10\" fill=\"#f59e0b\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- OutboundOrder -> OutboundDetail : 1:N red -->\r\n    <line x1=\"710\" y1=\"560\" x2=\"735\" y2=\"560\" stroke=\"#ef4444\"/>\r\n    <text x=\"722\" y=\"553\" font-size=\"10\" fill=\"#ef4444\" text-anchor=\"middle\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- StockTransfer -> StockTransferDetail : 1:N cyan -->\r\n    <line x1=\"1210\" y1=\"560\" x2=\"1225\" y2=\"560\" stroke=\"#06b3d4\"/>\r\n    <text x=\"1217\" y=\"553\" font-size=\"10\" fill=\"#06b3d4\" text-anchor=\"middle\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Supplier -> ContractPurchaseOrder : 1:N pink -->\r\n    <line x1=\"1210\" y1=\"102\" x2=\"1225\" y2=\"110\" stroke=\"#ec4899\"/>\r\n    <text x=\"1217\" y=\"95\" font-size=\"10\" fill=\"#ec4899\" text-anchor=\"middle\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Supplier -> InboundOrder : 1:N orange (long) -->\r\n    <line x1=\"1125\" y1=\"145\" x2=\"155\" y2=\"510\" stroke=\"#f59e0b\" stroke-dasharray=\"2 3\" opacity=\"0.55\"/>\r\n    <text x=\"640\" y=\"320\" font-size=\"10\" fill=\"#f59e0b\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- ContractPurchaseOrder -> InboundOrder : 1:N orange (long) -->\r\n    <line x1=\"1310\" y1=\"160\" x2=\"180\" y2=\"510\" stroke=\"#c2410c\" stroke-dasharray=\"2 3\" opacity=\"0.55\"/>\r\n    <text x=\"745\" y=\"335\" font-size=\"10\" fill=\"#c2410c\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Warehouse -> InboundOrder : 1:N blue (vertical left) -->\r\n    <line x1=\"40\" y1=\"135\" x2=\"40\" y2=\"540\" stroke=\"#3b82f6\" stroke-dasharray=\"4 2\"/>\r\n    <text x=\"30\" y=\"340\" font-size=\"10\" fill=\"#3b82f6\" text-anchor=\"end\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Warehouse -> OutboundOrder : 1:N blue -->\r\n    <line x1=\"170\" y1=\"160\" x2=\"610\" y2=\"510\" stroke=\"#3b82f6\" stroke-dasharray=\"4 2\" opacity=\"0.7\"/>\r\n    <text x=\"380\" y=\"330\" font-size=\"10\" fill=\"#3b82f6\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Warehouse -> StockTransfer : 1:N blue (long) -->\r\n    <line x1=\"200\" y1=\"160\" x2=\"1100\" y2=\"510\" stroke=\"#3b82f6\" stroke-dasharray=\"2 3\" opacity=\"0.45\"/>\r\n    <text x=\"650\" y=\"360\" font-size=\"10\" fill=\"#3b82f6\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Warehouse -> AssetEquipment : 1:N blue (long) -->\r\n    <line x1=\"205\" y1=\"160\" x2=\"1100\" y2=\"700\" stroke=\"#3b82f6\" stroke-dasharray=\"2 3\" opacity=\"0.4\"/>\r\n    <text x=\"640\" y=\"470\" font-size=\"10\" fill=\"#3b82f6\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Warehouse -> CheckOrder : 1:N blue (long) -->\r\n    <line x1=\"210\" y1=\"155\" x2=\"1280\" y2=\"700\" stroke=\"#3b82f6\" stroke-dasharray=\"2 3\" opacity=\"0.35\"/>\r\n    <text x=\"760\" y=\"430\" font-size=\"10\" fill=\"#3b82f6\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Project -> OutboundOrder : 1:N red -->\r\n    <line x1=\"625\" y1=\"700\" x2=\"625\" y2=\"610\" stroke=\"#ef4444\"/>\r\n    <text x=\"640\" y=\"660\" font-size=\"10\" fill=\"#ef4444\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Project -> StockTransfer : 1:N cyan -->\r\n    <line x1=\"710\" y1=\"735\" x2=\"1100\" y2=\"610\" stroke=\"#06b3d4\" stroke-dasharray=\"4 2\"/>\r\n    <text x=\"920\" y=\"680\" font-size=\"10\" fill=\"#06b3d4\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Project -> ContractPurchaseOrder : 1:N brown (long) -->\r\n    <line x1=\"710\" y1=\"715\" x2=\"1280\" y2=\"160\" stroke=\"#78350f\" stroke-dasharray=\"2 3\" opacity=\"0.5\"/>\r\n    <text x=\"1010\" y=\"430\" font-size=\"10\" fill=\"#78350f\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Product -> InboundDetail : 1:N purple -->\r\n    <line x1=\"780\" y1=\"160\" x2=\"320\" y2=\"510\" stroke=\"#8b5cf6\" stroke-dasharray=\"2 3\" opacity=\"0.5\"/>\r\n    <text x=\"540\" y=\"335\" font-size=\"10\" fill=\"#8b5cf6\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Product -> OutboundDetail : 1:N purple -->\r\n    <line x1=\"820\" y1=\"160\" x2=\"820\" y2=\"510\" stroke=\"#8b5cf6\" stroke-dasharray=\"4 2\"/>\r\n    <text x=\"833\" y=\"335\" font-size=\"10\" fill=\"#8b5cf6\" font-weight=\"bold\">1:N</text>\r\n\r\n    <!-- Product -> StockTransferDetail : 1:N purple (long) -->\r\n    <line x1=\"860\" y1=\"160\" x2=\"1280\" y2=\"510\" stroke=\"#8b5cf6\" stroke-dasharray=\"2 3\" opacity=\"0.4\"/>\r\n    <text x=\"1080\" y=\"335\" font-size=\"10\" fill=\"#8b5cf6\" font-weight=\"bold\">1:N</text>\r\n  </g>\r\n\r\n  <!-- ===== Entity boxes ===== -->\r\n\r\n  <!-- 1. Warehouse -->\r\n  <g transform=\"translate(40,60)\">\r\n    <rect width=\"170\" height=\"100\" fill=\"#dbeafe\" stroke=\"#3b82f6\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#3b82f6\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#3b82f6\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"13\" font-weight=\"bold\" text-anchor=\"middle\">Warehouse 仓库</text>\r\n    <text x=\"10\" y=\"48\" font-size=\"10\" font-weight=\"bold\" fill=\"#1e3a8a\">PK: id</text>\r\n    <text x=\"10\" y=\"64\" font-size=\"9.5\" fill=\"#334155\">code, name</text>\r\n    <text x=\"10\" y=\"78\" font-size=\"9.5\" fill=\"#334155\">category, property</text>\r\n    <text x=\"10\" y=\"92\" font-size=\"9.5\" fill=\"#334155\">status</text>\r\n  </g>\r\n\r\n  <!-- 2. Position -->\r\n  <g transform=\"translate(235,60)\">\r\n    <rect width=\"170\" height=\"100\" fill=\"#dbeafe\" stroke=\"#3b82f6\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#3b82f6\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#3b82f6\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"13\" font-weight=\"bold\" text-anchor=\"middle\">Position 仓位</text>\r\n    <text x=\"10\" y=\"48\" font-size=\"10\" font-weight=\"bold\" fill=\"#1e3a8a\">PK: id</text>\r\n    <text x=\"10\" y=\"64\" font-size=\"9.5\" fill=\"#334155\">FK: warehouseId → Warehouse</text>\r\n    <text x=\"10\" y=\"78\" font-size=\"9.5\" fill=\"#334155\">code, name</text>\r\n    <text x=\"10\" y=\"92\" font-size=\"9.5\" fill=\"#334155\">parentId</text>\r\n  </g>\r\n\r\n  <!-- 3. ProductCategory -->\r\n  <g transform=\"translate(540,60)\">\r\n    <rect width=\"170\" height=\"85\" fill=\"#ede9fe\" stroke=\"#8b5cf6\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#8b5cf6\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#8b5cf6\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"13\" font-weight=\"bold\" text-anchor=\"middle\">ProductCategory 物资分类</text>\r\n    <text x=\"10\" y=\"48\" font-size=\"10\" font-weight=\"bold\" fill=\"#4c1d95\">PK: id</text>\r\n    <text x=\"10\" y=\"64\" font-size=\"9.5\" fill=\"#334155\">code, name</text>\r\n    <text x=\"10\" y=\"78\" font-size=\"9.5\" fill=\"#334155\">parentId</text>\r\n  </g>\r\n\r\n  <!-- 4. Product -->\r\n  <g transform=\"translate(735,60)\">\r\n    <rect width=\"170\" height=\"100\" fill=\"#ede9fe\" stroke=\"#8b5cf6\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#8b5cf6\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#8b5cf6\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"13\" font-weight=\"bold\" text-anchor=\"middle\">Product 物资</text>\r\n    <text x=\"10\" y=\"48\" font-size=\"10\" font-weight=\"bold\" fill=\"#4c1d95\">PK: id</text>\r\n    <text x=\"10\" y=\"64\" font-size=\"9.5\" fill=\"#334155\">FK: categoryId → ProductCategory</text>\r\n    <text x=\"10\" y=\"78\" font-size=\"9.5\" fill=\"#334155\">code, name, specification</text>\r\n    <text x=\"10\" y=\"92\" font-size=\"9.5\" fill=\"#334155\">unit</text>\r\n  </g>\r\n\r\n  <!-- 5. Supplier -->\r\n  <g transform=\"translate(1040,60)\">\r\n    <rect width=\"170\" height=\"85\" fill=\"#fce7f3\" stroke=\"#ec4899\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#ec4899\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#ec4899\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"13\" font-weight=\"bold\" text-anchor=\"middle\">Supplier 供应商</text>\r\n    <text x=\"10\" y=\"48\" font-size=\"10\" font-weight=\"bold\" fill=\"#831843\">PK: id</text>\r\n    <text x=\"10\" y=\"64\" font-size=\"9.5\" fill=\"#334155\">code, name</text>\r\n    <text x=\"10\" y=\"78\" font-size=\"9.5\" fill=\"#334155\">contact, phone</text>\r\n  </g>\r\n\r\n  <!-- 6. ContractPurchaseOrder -->\r\n  <g transform=\"translate(1225,60)\">\r\n    <rect width=\"170\" height=\"100\" fill=\"#ffedd5\" stroke=\"#c2410c\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#c2410c\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#c2410c\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"12\" font-weight=\"bold\" text-anchor=\"middle\">ContractPurchaseOrder</text>\r\n    <text x=\"85\" y=\"42\" fill=\"#7c2d12\" font-size=\"9.5\" text-anchor=\"middle\">合同采购订单</text>\r\n    <text x=\"10\" y=\"56\" font-size=\"10\" font-weight=\"bold\" fill=\"#7c2d12\">PK: id</text>\r\n    <text x=\"10\" y=\"70\" font-size=\"9\" fill=\"#334155\">FK: contractId, supplierId</text>\r\n    <text x=\"10\" y=\"82\" font-size=\"9\" fill=\"#334155\">FK: projectId → Project</text>\r\n    <text x=\"10\" y=\"94\" font-size=\"9\" fill=\"#334155\">orderNo, status</text>\r\n  </g>\r\n\r\n  <!-- 7. Inventory -->\r\n  <g transform=\"translate(440,290)\">\r\n    <rect width=\"170\" height=\"100\" fill=\"#d1fae5\" stroke=\"#10b981\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#10b981\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#10b981\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"13\" font-weight=\"bold\" text-anchor=\"middle\">Inventory 库存</text>\r\n    <text x=\"10\" y=\"48\" font-size=\"10\" font-weight=\"bold\" fill=\"#064e3b\">PK: id</text>\r\n    <text x=\"10\" y=\"64\" font-size=\"9\" fill=\"#334155\">FK: productId, warehouseId</text>\r\n    <text x=\"10\" y=\"78\" font-size=\"9\" fill=\"#334155\">FK: positionId → Position</text>\r\n    <text x=\"10\" y=\"92\" font-size=\"9\" fill=\"#334155\">quantity, frozen, available</text>\r\n  </g>\r\n\r\n  <!-- 8. BatchInventory -->\r\n  <g transform=\"translate(640,290)\">\r\n    <rect width=\"170\" height=\"100\" fill=\"#d1fae5\" stroke=\"#10b981\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#10b981\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#10b981\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"12\" font-weight=\"bold\" text-anchor=\"middle\">BatchInventory</text>\r\n    <text x=\"85\" y=\"42\" fill=\"#064e3b\" font-size=\"9.5\" text-anchor=\"middle\">批次库存</text>\r\n    <text x=\"10\" y=\"56\" font-size=\"10\" font-weight=\"bold\" fill=\"#064e3b\">PK: id</text>\r\n    <text x=\"10\" y=\"70\" font-size=\"9\" fill=\"#334155\">FK: productId, warehouseId</text>\r\n    <text x=\"10\" y=\"82\" font-size=\"9\" fill=\"#334155\">FK: positionId, inboundOrderId</text>\r\n    <text x=\"10\" y=\"94\" font-size=\"9\" fill=\"#334155\">batchNo, quantity</text>\r\n  </g>\r\n\r\n  <!-- 9. StockTransaction -->\r\n  <g transform=\"translate(840,290)\">\r\n    <rect width=\"170\" height=\"100\" fill=\"#f1f5f9\" stroke=\"#64748b\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#64748b\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#64748b\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"12\" font-weight=\"bold\" text-anchor=\"middle\">StockTransaction</text>\r\n    <text x=\"85\" y=\"42\" fill=\"#1e293b\" font-size=\"9.5\" text-anchor=\"middle\">库存流水</text>\r\n    <text x=\"10\" y=\"56\" font-size=\"10\" font-weight=\"bold\" fill=\"#1e293b\">PK: id</text>\r\n    <text x=\"10\" y=\"70\" font-size=\"9\" fill=\"#334155\">FK: productId, warehouseId</text>\r\n    <text x=\"10\" y=\"82\" font-size=\"9\" fill=\"#334155\">FK: sourceOrderId</text>\r\n    <text x=\"10\" y=\"94\" font-size=\"9\" fill=\"#334155\">transactionNo, type, qty</text>\r\n  </g>\r\n\r\n  <!-- 10. InboundOrder -->\r\n  <g transform=\"translate(40,510)\">\r\n    <rect width=\"170\" height=\"100\" fill=\"#fef3c7\" stroke=\"#f59e0b\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#f59e0b\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#f59e0b\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"13\" font-weight=\"bold\" text-anchor=\"middle\">InboundOrder 入库单</text>\r\n    <text x=\"10\" y=\"48\" font-size=\"10\" font-weight=\"bold\" fill=\"#78350f\">PK: id</text>\r\n    <text x=\"10\" y=\"64\" font-size=\"9\" fill=\"#334155\">FK: supplierId, warehouseId</text>\r\n    <text x=\"10\" y=\"78\" font-size=\"9\" fill=\"#334155\">FK: purchaseOrderId → CPO</text>\r\n    <text x=\"10\" y=\"92\" font-size=\"9\" fill=\"#334155\">orderNo, type, status</text>\r\n  </g>\r\n\r\n  <!-- 11. InboundDetail -->\r\n  <g transform=\"translate(235,510)\">\r\n    <rect width=\"170\" height=\"100\" fill=\"#fef3c7\" stroke=\"#f59e0b\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#f59e0b\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#f59e0b\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"13\" font-weight=\"bold\" text-anchor=\"middle\">InboundDetail 入库明细</text>\r\n    <text x=\"10\" y=\"48\" font-size=\"10\" font-weight=\"bold\" fill=\"#78350f\">PK: id</text>\r\n    <text x=\"10\" y=\"64\" font-size=\"9\" fill=\"#334155\">FK: inboundOrderId, productId</text>\r\n    <text x=\"10\" y=\"78\" font-size=\"9\" fill=\"#334155\">FK: positionId → Position</text>\r\n    <text x=\"10\" y=\"92\" font-size=\"9\" fill=\"#334155\">quantity</text>\r\n  </g>\r\n\r\n  <!-- 12. OutboundOrder -->\r\n  <g transform=\"translate(540,510)\">\r\n    <rect width=\"170\" height=\"100\" fill=\"#fee2e2\" stroke=\"#ef4444\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#ef4444\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#ef4444\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"13\" font-weight=\"bold\" text-anchor=\"middle\">OutboundOrder 出库单</text>\r\n    <text x=\"10\" y=\"48\" font-size=\"10\" font-weight=\"bold\" fill=\"#7f1d1d\">PK: id</text>\r\n    <text x=\"10\" y=\"64\" font-size=\"9\" fill=\"#334155\">FK: warehouseId → Warehouse</text>\r\n    <text x=\"10\" y=\"78\" font-size=\"9\" fill=\"#334155\">FK: projectId → Project</text>\r\n    <text x=\"10\" y=\"92\" font-size=\"9\" fill=\"#334155\">orderNo, type, status</text>\r\n  </g>\r\n\r\n  <!-- 13. OutboundDetail -->\r\n  <g transform=\"translate(735,510)\">\r\n    <rect width=\"170\" height=\"100\" fill=\"#fee2e2\" stroke=\"#ef4444\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#ef4444\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#ef4444\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"13\" font-weight=\"bold\" text-anchor=\"middle\">OutboundDetail 出库明细</text>\r\n    <text x=\"10\" y=\"48\" font-size=\"10\" font-weight=\"bold\" fill=\"#7f1d1d\">PK: id</text>\r\n    <text x=\"10\" y=\"64\" font-size=\"9\" fill=\"#334155\">FK: outboundOrderId</text>\r\n    <text x=\"10\" y=\"78\" font-size=\"9\" fill=\"#334155\">FK: productId → Product</text>\r\n    <text x=\"10\" y=\"92\" font-size=\"9\" fill=\"#334155\">quantity, workOrderId</text>\r\n  </g>\r\n\r\n  <!-- 14. StockTransfer -->\r\n  <g transform=\"translate(1040,510)\">\r\n    <rect width=\"170\" height=\"100\" fill=\"#cffafe\" stroke=\"#06b3d4\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#06b3d4\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#06b3d4\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"13\" font-weight=\"bold\" text-anchor=\"middle\">StockTransfer 调拨单</text>\r\n    <text x=\"10\" y=\"48\" font-size=\"10\" font-weight=\"bold\" fill=\"#155e75\">PK: id</text>\r\n    <text x=\"10\" y=\"64\" font-size=\"9\" fill=\"#334155\">FK: fromWarehouseId, toWarehouseId</text>\r\n    <text x=\"10\" y=\"78\" font-size=\"9\" fill=\"#334155\">FK: projectId → Project</text>\r\n    <text x=\"10\" y=\"92\" font-size=\"9\" fill=\"#334155\">transferNo, status</text>\r\n  </g>\r\n\r\n  <!-- 15. StockTransferDetail -->\r\n  <g transform=\"translate(1225,510)\">\r\n    <rect width=\"170\" height=\"100\" fill=\"#cffafe\" stroke=\"#06b3d4\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#06b3d4\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#06b3d4\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"12\" font-weight=\"bold\" text-anchor=\"middle\">StockTransferDetail</text>\r\n    <text x=\"85\" y=\"42\" fill=\"#155e75\" font-size=\"9.5\" text-anchor=\"middle\">调拨明细</text>\r\n    <text x=\"10\" y=\"56\" font-size=\"10\" font-weight=\"bold\" fill=\"#155e75\">PK: id</text>\r\n    <text x=\"10\" y=\"70\" font-size=\"9\" fill=\"#334155\">FK: transferOrderId</text>\r\n    <text x=\"10\" y=\"82\" font-size=\"9\" fill=\"#334155\">FK: productId → Product</text>\r\n    <text x=\"10\" y=\"94\" font-size=\"9\" fill=\"#334155\">quantity, workOrderId</text>\r\n  </g>\r\n\r\n  <!-- 16. Project -->\r\n  <g transform=\"translate(540,700)\">\r\n    <rect width=\"170\" height=\"70\" fill=\"#fef3c7\" stroke=\"#78350f\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#78350f\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#78350f\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"13\" font-weight=\"bold\" text-anchor=\"middle\">Project 项目</text>\r\n    <text x=\"10\" y=\"48\" font-size=\"10\" font-weight=\"bold\" fill=\"#451a03\">PK: id</text>\r\n    <text x=\"10\" y=\"64\" font-size=\"9.5\" fill=\"#334155\">name, type</text>\r\n  </g>\r\n\r\n  <!-- 17. AssetEquipment -->\r\n  <g transform=\"translate(1040,700)\">\r\n    <rect width=\"170\" height=\"85\" fill=\"#e0e7ff\" stroke=\"#6366f1\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#6366f1\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#6366f1\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"12\" font-weight=\"bold\" text-anchor=\"middle\">AssetEquipment 固定资产</text>\r\n    <text x=\"10\" y=\"48\" font-size=\"10\" font-weight=\"bold\" fill=\"#312e81\">PK: id</text>\r\n    <text x=\"10\" y=\"64\" font-size=\"9\" fill=\"#334155\">FK: warehouseId, positionId</text>\r\n    <text x=\"10\" y=\"78\" font-size=\"9\" fill=\"#334155\">code, name, status</text>\r\n  </g>\r\n\r\n  <!-- 18. CheckOrder -->\r\n  <g transform=\"translate(1225,700)\">\r\n    <rect width=\"170\" height=\"85\" fill=\"#fef9c3\" stroke=\"#eab308\" stroke-width=\"2\" rx=\"4\"/>\r\n    <rect width=\"170\" height=\"30\" fill=\"#eab308\" rx=\"4\"/>\r\n    <rect y=\"22\" width=\"170\" height=\"8\" fill=\"#eab308\"/>\r\n    <text x=\"85\" y=\"20\" fill=\"white\" font-size=\"13\"