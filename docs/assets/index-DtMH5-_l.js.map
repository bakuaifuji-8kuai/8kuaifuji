export default "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\r\n<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 700\" font-family=\"Microsoft YaHei, sans-serif\">\r\n  <defs>\r\n    <marker id=\"arrow-down\" viewBox=\"0 0 10 10\" refX=\"5\" refY=\"9\" markerWidth=\"8\" markerHeight=\"8\" orient=\"auto\">\r\n      <path d=\"M0,0 L10,0 L5,10 z\" fill=\"#64748b\"/>\r\n    </marker>\r\n    <linearGradient id=\"grad-purple\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\r\n      <stop offset=\"0%\" stop-color=\"#8b5cf6\"/>\r\n      <stop offset=\"100%\" stop-color=\"#6366f1\"/>\r\n    </linearGradient>\r\n  </defs>\r\n\r\n  <!-- Background -->\r\n  <rect width=\"1200\" height=\"700\" fill=\"#ffffff\"/>\r\n\r\n  <!-- Title -->\r\n  <text x=\"600\" y=\"32\" text-anchor=\"middle\" font-size=\"22\" font-weight=\"bold\" fill=\"#1e293b\">仓库管理系统 - 系统架构图</text>\r\n\r\n  <!-- ===== Layer 1: User Layer ===== -->\r\n  <rect x=\"20\" y=\"55\" width=\"1160\" height=\"95\" fill=\"#eff6ff\" stroke=\"#3b82f6\" stroke-width=\"1.5\" stroke-dasharray=\"5,3\" rx=\"8\"/>\r\n  <text x=\"40\" y=\"100\" font-size=\"15\" font-weight=\"bold\" fill=\"#3b82f6\">用户层</text>\r\n  <text x=\"40\" y=\"120\" font-size=\"10\" fill=\"#3b82f6\">User Layer</text>\r\n\r\n  <!-- Web Browser -->\r\n  <rect x=\"450\" y=\"75\" width=\"180\" height=\"60\" rx=\"8\" fill=\"#dbeafe\" stroke=\"#3b82f6\" stroke-width=\"1.5\"/>\r\n  <rect x=\"462\" y=\"92\" width=\"26\" height=\"20\" rx=\"3\" fill=\"#ffffff\" stroke=\"#3b82f6\" stroke-width=\"1\"/>\r\n  <line x1=\"462\" y1=\"99\" x2=\"488\" y2=\"99\" stroke=\"#3b82f6\" stroke-width=\"0.8\"/>\r\n  <circle cx=\"467\" cy=\"96\" r=\"1.2\" fill=\"#ef4444\"/>\r\n  <circle cx=\"471\" cy=\"96\" r=\"1.2\" fill=\"#f59e0b\"/>\r\n  <circle cx=\"475\" cy=\"96\" r=\"1.2\" fill=\"#10b981\"/>\r\n  <text x=\"555\" y=\"100\" text-anchor=\"middle\" font-size=\"13\" font-weight=\"bold\" fill=\"#1e293b\">Web浏览器</text>\r\n  <text x=\"555\" y=\"118\" text-anchor=\"middle\" font-size=\"10\" fill=\"#3b82f6\">Chrome / Edge / Safari</text>\r\n\r\n  <!-- Mobile App -->\r\n  <rect x=\"690\" y=\"75\" width=\"180\" height=\"60\" rx=\"8\" fill=\"#dbeafe\" stroke=\"#3b82f6\" stroke-width=\"1.5\"/>\r\n  <rect x=\"704\" y=\"88\" width=\"20\" height=\"32\" rx=\"3\" fill=\"#ffffff\" stroke=\"#3b82f6\" stroke-width=\"1\"/>\r\n  <line x1=\"708\" y1=\"93\" x2=\"720\" y2=\"93\" stroke=\"#3b82f6\" stroke-width=\"0.8\"/>\r\n  <circle cx=\"714\" cy=\"115\" r=\"1.5\" fill=\"#3b82f6\"/>\r\n  <text x=\"800\" y=\"100\" text-anchor=\"middle\" font-size=\"13\" font-weight=\"bold\" fill=\"#1e293b\">移动端APP</text>\r\n  <text x=\"800\" y=\"118\" text-anchor=\"middle\" font-size=\"10\" fill=\"#3b82f6\">iOS / Android</text>\r\n\r\n  <!-- Arrow 1: User -> Frontend -->\r\n  <line x1=\"600\" y1=\"150\" x2=\"600\" y2=\"178\" stroke=\"#64748b\" stroke-width=\"1.5\" marker-end=\"url(#arrow-down)\"/>\r\n\r\n  <!-- ===== Layer 2: Frontend Layer ===== -->\r\n  <rect x=\"20\" y=\"180\" width=\"1160\" height=\"95\" fill=\"#f5f3ff\" stroke=\"#8b5cf6\" stroke-width=\"1.5\" stroke-dasharray=\"5,3\" rx=\"8\"/>\r\n  <text x=\"40\" y=\"225\" font-size=\"15\" font-weight=\"bold\" fill=\"#8b5cf6\">前端层</text>\r\n  <text x=\"40\" y=\"245\" font-size=\"10\" fill=\"#8b5cf6\">Frontend</text>\r\n\r\n  <!-- React -->\r\n  <rect x=\"160\" y=\"200\" width=\"155\" height=\"60\" rx=\"8\" fill=\"#ede9fe\" stroke=\"#8b5cf6\" stroke-width=\"1.5\"/>\r\n  <circle cx=\"190\" cy=\"230\" r=\"11\" fill=\"none\" stroke=\"#8b5cf6\" stroke-width=\"1.2\"/>\r\n  <ellipse cx=\"190\" cy=\"230\" rx=\"11\" ry=\"4\" fill=\"none\" stroke=\"#8b5cf6\" stroke-width=\"1\"/>\r\n  <ellipse cx=\"190\" cy=\"230\" rx=\"4\" ry=\"11\" fill=\"none\" stroke=\"#8b5cf6\" stroke-width=\"1\"/>\r\n  <circle cx=\"190\" cy=\"230\" r=\"2\" fill=\"#8b5cf6\"/>\r\n  <text x=\"248\" y=\"227\" text-anchor=\"middle\" font-size=\"13\" font-weight=\"bold\" fill=\"#1e293b\">React</text>\r\n  <text x=\"248\" y=\"245\" text-anchor=\"middle\" font-size=\"10\" fill=\"#8b5cf6\">UI框架</text>\r\n\r\n  <!-- TypeScript -->\r\n  <rect x=\"330\" y=\"200\" width=\"155\" height=\"60\" rx=\"8\" fill=\"#ede9fe\" stroke=\"#8b5cf6\" stroke-width=\"1.5\"/>\r\n  <rect x=\"348\" y=\"218\" width=\"24\" height=\"24\" rx=\"3\" fill=\"#3178c6\"/>\r\n  <text x=\"360\" y=\"236\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"bold\" fill=\"#ffffff\">TS</text>\r\n  <text x=\"418\" y=\"227\" text-anchor=\"middle\" font-size=\"13\" font-weight=\"bold\" fill=\"#1e293b\">TypeScript</text>\r\n  <text x=\"418\" y=\"245\" text-anchor=\"middle\" font-size=\"10\" fill=\"#8b5cf6\">类型系统</text>\r\n\r\n  <!-- Vite -->\r\n  <rect x=\"500\" y=\"200\" width=\"155\" height=\"60\" rx=\"8\" fill=\"#ede9fe\" stroke=\"#8b5cf6\" stroke-width=\"1.5\"/>\r\n  <path d=\"M530 218 L540 234 L535 234 L545 246 L525 230 L530 230 Z\" fill=\"#facc15\" stroke=\"#8b5cf6\" stroke-width=\"0.6\"/>\r\n  <text x=\"588\" y=\"227\" text-anchor=\"middle\" font-size=\"13\" font-weight=\"bold\" fill=\"#1e293b\">Vite</text>\r\n  <text x=\"588\" y=\"245\" text-anchor=\"middle\" font-size=\"10\" fill=\"#8b5cf6\">构建工具</text>\r\n\r\n  <!-- TailwindCSS -->\r\n  <rect x=\"670\" y=\"200\" width=\"155\" height=\"60\" rx=\"8\" fill=\"#ede9fe\" stroke=\"#8b5cf6\" stroke-width=\"1.5\"/>\r\n  <path d=\"M688 232 Q695 222 702 230 Q709 220 716 228 Q723 218 730 226\" fill=\"none\" stroke=\"#06b6d4\" stroke-width=\"2\"/>\r\n  <text x=\"758\" y=\"227\" text-anchor=\"middle\" font-size=\"13\" font-weight=\"bold\" fill=\"#1e293b\">TailwindCSS</text>\r\n  <text x=\"758\" y=\"245\" text-anchor=\"middle\" font-size=\"10\" fill=\"#8b5cf6\">样式框架</text>\r\n\r\n  <!-- Zustand -->\r\n  <rect x=\"840\" y=\"200\" width=\"155\" height=\"60\" rx=\"8\" fill=\"#ede9fe\" stroke=\"#8b5cf6\" stroke-width=\"1.5\"/>\r\n  <rect x=\"858\" y=\"220\" width=\"24\" height=\"20\" rx=\"3\" fill=\"#ffffff\" stroke=\"#8b5cf6\" stroke-width=\"1\"/>\r\n  <path d=\"M862 226 L878 226 M862 230 L878 230 M862 234 L874 234\" stroke=\"#8b5cf6\" stroke-width=\"0.8\"/>\r\n  <text x=\"928\" y=\"227\" text-anchor=\"middle\" font-size=\"13\" font-weight=\"bold\" fill=\"#1e293b\">Zustand</text>\r\n  <text x=\"928\" y=\"245\" text-anchor=\"middle\" font-size=\"10\" fill=\"#8b5cf6\">状态管理</text>\r\n\r\n  <!-- React Router -->\r\n  <rect x=\"1010\" y=\"200\" width=\"155\" height=\"60\" rx=\"8\" fill=\"#ede9fe\" stroke=\"#8b5cf6\" stroke-width=\"1.5\"/>\r\n  <path d=\"M1028 222 L1040 222 M1036 218 L1040 222 L1036 226 M1044 230 L1056 230 M1052 226 L1056 230 L1052 234 M1032 238 L1044 238 M1040 234 L1044 238 L1040 242\" fill=\"none\" stroke=\"#8b5cf6\" stroke-width=\"1.2\"/>\r\n  <text x=\"1098\" y=\"227\" text-anchor=\"middle\" font-size=\"13\" font-weight=\"bold\" fill=\"#1e293b\">React Router</text>\r\n  <text x=\"1098\" y=\"245\" text-anchor=\"middle\" font-size=\"10\" fill=\"#8b5cf6\">路由管理</text>\r\n\r\n  <!-- Arrow 2: Frontend -> Routing -->\r\n  <line x1=\"600\" y1=\"275\" x2=\"600\" y2=\"303\" stroke=\"#64748b\" stroke-width=\"1.5\" marker-end=\"url(#arrow-down)\"/>\r\n\r\n  <!-- ===== Layer 3: Routing Layer ===== -->\r\n  <rect x=\"20\" y=\"305\" width=\"1160\" height=\"95\" fill=\"#ecfeff\" stroke=\"#06b3d4\" stroke-width=\"1.5\" stroke-dasharray=\"5,3\" rx=\"8\"/>\r\n  <text x=\"40\" y=\"350\" font-size=\"15\" font-weight=\"bold\" fill=\"#06b3d4\">路由层</text>\r\n  <text x=\"40\" y=\"370\" font-size=\"10\" fill=\"#06b3d4\">Routing</text>\r\n\r\n  <!-- 9 routing items, w=105 gap=10, start x=152 -->\r\n  <!-- 1. 采购管理 -->\r\n  <rect x=\"152\" y=\"325\" width=\"105\" height=\"55\" rx=\"8\" fill=\"#cffafe\" stroke=\"#06b3d4\" stroke-width=\"1.5\"/>\r\n  <circle cx=\"170\" cy=\"345\" r=\"9\" fill=\"#06b3d4\"/>\r\n  <text x=\"170\" y=\"349\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"bold\" fill=\"#ffffff\">1</text>\r\n  <text x=\"215\" y=\"350\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"bold\" fill=\"#1e293b\">采购管理</text>\r\n  <text x=\"215\" y=\"368\" text-anchor=\"middle\" font-size=\"9\" fill=\"#06b3d4\">Purchase</text>\r\n\r\n  <!-- 2. 库存管理 -->\r\n  <rect x=\"267\" y=\"325\" width=\"105\" height=\"55\" rx=\"8\" fill=\"#cffafe\" stroke=\"#06b3d4\" stroke-width=\"1.5\"/>\r\n  <circle cx=\"285\" cy=\"345\" r=\"9\" fill=\"#06b3d4\"/>\r\n  <text x=\"285\" y=\"349\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"bold\" fill=\"#ffffff\">2</text>\r\n  <text x=\"330\" y=\"350\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"bold\" fill=\"#1e293b\">库存管理</text>\r\n  <text x=\"330\" y=\"368\" text-anchor=\"middle\" font-size=\"9\" fill=\"#06b3d4\">Inventory</text>\r\n\r\n  <!-- 3. 入库管理 -->\r\n  <rect x=\"382\" y=\"325\" width=\"105\" height=\"55\" rx=\"8\" fill=\"#cffafe\" stroke=\"#06b3d4\" stroke-width=\"1.5\"/>\r\n  <circle cx=\"400\" cy=\"345\" r=\"9\" fill=\"#06b3d4\"/>\r\n  <text x=\"400\" y=\"349\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"bold\" fill=\"#ffffff\">3</text>\r\n  <text x=\"445\" y=\"350\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"bold\" fill=\"#1e293b\">入库管理</text>\r\n  <text x=\"445\" y=\"368\" text-anchor=\"middle\" font-size=\"9\" fill=\"#06b3d4\">Inbound</text>\r\n\r\n  <!-- 4. 出库管理 -->\r\n  <rect x=\"497\" y=\"325\" width=\"105\" height=\"55\" rx=\"8\" fill=\"#cffafe\" stroke=\"#06b3d4\" stroke-width=\"1.5\"/>\r\n  <circle cx=\"515\" cy=\"345\" r=\"9\" fill=\"#06b3d4\"/>\r\n  <text x=\"515\" y=\"349\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"bold\" fill=\"#ffffff\">4</text>\r\n  <text x=\"560\" y=\"350\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"bold\" fill=\"#1e293b\">出库管理</text>\r\n  <text x=\"560\" y=\"368\" text-anchor=\"middle\" font-size=\"9\" fill=\"#06b3d4\">Outbound</text>\r\n\r\n  <!-- 5. 展会物资调拨管理 -->\r\n  <rect x=\"612\" y=\"325\" width=\"105\" height=\"55\" rx=\"8\" fill=\"#cffafe\" stroke=\"#06b3d4\" stroke-width=\"1.5\"/>\r\n  <circle cx=\"630\" cy=\"345\" r=\"9\" fill=\"#06b3d4\"/>\r\n  <text x=\"630\" y=\"349\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"bold\" fill=\"#ffffff\">5</text>\r\n  <text x=\"675\" y=\"346\" text-anchor=\"middle\" font-size=\"10\" font-weight=\"bold\" fill=\"#1e293b\">展会物资</text>\r\n  <text x=\"675\" y=\"360\" text-anchor=\"middle\" font-size=\"10\" font-weight=\"bold\" fill=\"#1e293b\">调拨管理</text>\r\n  <text x=\"675\" y=\"372\" text-anchor=\"middle\" font-size=\"8\" fill=\"#06b3d4\">Exhibit Transfer</text>\r\n\r\n  <!-- 6. 调拨管理 -->\r\n  <rect x=\"727\" y=\"325\" width=\"105\" height=\"55\" rx=\"8\" fill=\"#cffafe\" stroke=\"#06b3d4\" stroke-width=\"1.5\"/>\r\n  <circle cx=\"745\" cy=\"345\" r=\"9\" fill=\"#06b3d4\"/>\r\n  <text x=\"745\" y=\"349\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"bold\" fill=\"#ffffff\">6</text>\r\n  <text x=\"790\" y=\"350\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"bold\" fill=\"#1e293b\">调拨管理</text>\r\n  <text x=\"790\" y=\"368\" text-anchor=\"middle\" font-size=\"9\" fill=\"#06b3d4\">Transfer</text>\r\n\r\n  <!-- 7. 固定资产管理 -->\r\n  <rect x=\"842\" y=\"325\" width=\"105\" height=\"55\" rx=\"8\" fill=\"#cffafe\" stroke=\"#06b3d4\" stroke-width=\"1.5\"/>\r\n  <circle cx=\"860\" cy=\"345\" r=\"9\" fill=\"#06b3d4\"/>\r\n  <text x=\"860\" y=\"349\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"bold\" fill=\"#ffffff\">7</text>\r\n  <text x=\"905\" y=\"346\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"bold\" fill=\"#1e293b\">固定资产</text>\r\n  <text x=\"905\" y=\"360\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"bold\" fill=\"#1e293b\">管理</text>\r\n  <text x=\"905\" y=\"372\" text-anchor=\"middle\" font-size=\"8\" fill=\"#06b3d4\">Fixed Assets</text>\r\n\r\n  <!-- 8. 基础资料 -->\r\n  <rect x=\"957\" y=\"325\" width=\"105\" height=\"55\" rx=\"8\" fill=\"#cffafe\" stroke=\"#06b3d4\" stroke-width=\"1.5\"/>\r\n  <circle cx=\"975\" cy=\"345\" r=\"9\" fill=\"#06b3d4\"/>\r\n  <text x=\"975\" y=\"349\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"bold\" fill=\"#ffffff\">8</text>\r\n  <text x=\"1020\" y=\"350\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"bold\" fill=\"#1e293b\">基础资料</text>\r\n  <text x=\"1020\" y=\"368\" text-anchor=\"middle\" font-size=\"9\" fill=\"#06b3d4\">Master Data</text>\r\n\r\n  <!-- 9. 报表管理 -->\r\n  <rect x=\"1072\" y=\"325\" width=\"105\" height=\"55\" rx=\"8\" fill=\"#cffafe\" stroke=\"#06b3d4\" stroke-width=\"1.5\"/>\r\n  <circle cx=\"1090\" cy=\"345\" r=\"9\" fill=\"#06b3d4\"/>\r\n  <text x=\"1090\" y=\"349\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"bold\" fill=\"#ffffff\">9</text>\r\n  <text x=\"1135\" y=\"350\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"bold\" fill=\"#1e293b\">报表管理</text>\r\n  <text x=\"1135\" y=\"368\" text-anchor=\"middle\" font-size=\"9\" fill=\"#06b3d4\">Reports</text>\r\n\r\n  <!-- Arrow 3: Routing -> Data -->\r\n  <line x1=\"600\" y1=\"400\" x2=\"600\" y2=\"428\" stroke=\"#64748b\" stroke-width=\"1.5\" marker-end=\"url(#arrow-down)\"/>\r\n\r\n  <!-- ===== Layer 4: Data Layer ===== -->\r\n  <rect x=\"20\" y=\"430\" width=\"1160\" height=\"95\" fill=\"#ecfdf5\" stroke=\"#10b981\" stroke-width=\"1.5\" stroke-dasharray=\"5,3\" rx=\"8\"/>\r\n  <text x=\"40\" y=\"475\" font-size=\"15\" font-weight=\"bold\" fill=\"#10b981\">数据层</text>\r\n  <text x=\"40\" y=\"495\" font-size=\"10\" fill=\"#10b981\">Data Layer</text>\r\n\r\n  <!-- Mock数据 -->\r\n  <rect x=\"215\" y=\"450\" width=\"280\" height=\"60\" rx=\"8\" fill=\"#d1fae5\" stroke=\"#10b981\" stroke-width=\"1.5\"/>\r\n  <path d=\"M235 462 L235 498 Q235 502 239 502 L259 502 Q263 502 263 498 L263 462 L257 462 L257 458 L241 458 L241 462 Z\" fill=\"#ffffff\" stroke=\"#10b981\" stroke-width=\"1\"/>\r\n  <line x1=\"244\" y1=\"472\" x2=\"254\" y2=\"472\" stroke=\"#10b981\" stroke-width=\"0.8\"/>\r\n  <line x1=\"244\" y1=\"478\" x2=\"254\" y2=\"478\" stroke=\"#10b981\" stroke-width=\"0.8\"/>\r\n  <line x1=\"244\" y1=\"484\" x2=\"252\" y2=\"484\" stroke=\"#10b981\" stroke-width=\"0.8\"/>\r\n  <text x=\"365\" y=\"478\" text-anchor=\"middle\" font-size=\"1